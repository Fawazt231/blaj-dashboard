{
  "name": "blaj-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "sim:explore": "node scripts/simulationExplorer.mjs",
    "sim:backfill": "node scripts/backfillHistoricalOdds.mjs",
    "sim:calibrate": "node scripts/calibrateHistoricalOdds.mjs",
    "data:rosters": "node scripts/backfillRosterSnapshots.mjs",
    "data:rosters-point-in-time": "node scripts/backfillPointInTimeRosters.mjs",
    "data:roster-features": "node scripts/buildRosterProjectionFeatures.mjs",
    "data:roster-features-point-in-time": "ROSTER_FEATURE_ROSTER_INPUT=data/historical_point_in_time_rosters.json ROSTER_FEATURE_OUTPUT=data/historical_point_in_time_projection_features.json node scripts/buildRosterProjectionFeatures.mjs",
    "data:usage": "python3 scripts/backfillHistoricalPlayerUsage.py",
    "model:roster-evaluate": "node scripts/evaluateRosterProjectionFeatures.mjs",
    "model:roster-compare": "node scripts/compareRosterProjectionFeatures.mjs",
    "model:usage-evaluate": "python3 scripts/evaluateHistoricalPlayerUsage.py"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
